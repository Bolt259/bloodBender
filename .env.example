# bloodBath Configuration
# Copy this file to .env and fill in your credentials

# Tandem t:connect Credentials (Required)
TCONNECT_EMAIL=your@email.com
TCONNECT_PASSWORD=your_password

# Regional and Timezone Configuration
TCONNECT_REGION=US
TIMEZONE_NAME=America/Los_Angeles

# Pump Configuration inferred on Tandem t:connect account (Optional)
# If you have multiple pumps or want to specify a particular pump, you can set the serial number here. Otherwise, bloodBath use all pumps on account..

# Authentication Settings
CACHE_CREDENTIALS=true

# Optional Configuration
BLOODBATH_OUTPUT_DIR=./data
BLOODBATH_LOG_LEVEL=INFO

# Push Notifications (IN-01) — ntfy.sh
# Set NTFY_TOPIC to enable push alerts for hypo risk and failure modes.
# Create a free topic at https://ntfy.sh (no account required).
# Subscribe on your phone with the ntfy app: ntfy.sh/<your-topic>
# NTFY_TOPIC=bloodbender-yourname
# NTFY_URL=https://ntfy.sh  # override for self-hosted ntfy server

# Alternative variable names (if you prefer)
# BLOODBATH_EMAIL=your@email.com
# BLOODBATH_PASSWORD=your_password
# BLOODBATH_REGION=US
# BLOODBATH_TIMEZONE=America/Los_Angeles
# BLOODBATH_PUMP_SERIAL=881235
# BLOODBATH_CACHE_CREDENTIALS=true
